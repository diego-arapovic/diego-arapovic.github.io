---
import { site } from '../site.config';
import Icon from './Icon.astro';

const featured = site.projects.filter((p) => p.featured);
const rest = site.projects.filter((p) => !p.featured);
---

<section
  id="projects"
  class="border-t border-slate-200/60 dark:border-slate-800/60"
>
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <div class="max-w-2xl">
      <h2
        class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Projects
      </h2>
      <p
        class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
      >
        Things I've built
      </p>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
        A selection of work I'm proud of.
      </p>
    </div>

    <!-- Featured project(s): large cards -->
    <div class="mt-12 space-y-8">
      {
        featured.map((project) => (
          <article class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-indigo-300 hover:shadow-lg sm:p-8 md:grid-cols-2 md:items-center dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-indigo-700">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">
                Featured project
              </p>
              <h3 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">
                {project.name}
              </h3>
              <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-400">
                {project.description}
              </p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {project.tech.map((t) => (
                  <li class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {t}
                  </li>
                ))}
              </ul>
              <div class="mt-6 flex flex-wrap gap-3">
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-500"
                  >
                    Live demo
                    <Icon name="external" class="h-4 w-4" />
                  </a>
                )}
                {project.source && (
                  <a
                    href={project.source}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
                  >
                    <Icon name="github" class="h-4 w-4" />
                    Source
                  </a>
                )}
              </div>
            </div>

            {/* Preview image if provided, else a tasteful branded panel. */}
            {project.image ? (
              <img
                src={project.image}
                alt={`${project.name} preview`}
                class="aspect-video w-full rounded-xl object-cover ring-1 ring-slate-200 dark:ring-slate-800"
              />
            ) : (
              <div class="flex aspect-video items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500/10 via-violet-500/10 to-transparent ring-1 ring-inset ring-slate-200 dark:ring-slate-800">
                <span class="select-none bg-gradient-to-r from-indigo-600 to-violet-500 bg-clip-text text-7xl font-extrabold text-transparent dark:from-indigo-400 dark:to-violet-400">
                  {project.name.charAt(0)}
                </span>
              </div>
            )}
          </article>
        ))
      }
    </div>

    <!-- Additional projects: compact grid -->
    {
      rest.length > 0 && (
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {rest.map((project) => (
            <article class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-indigo-300 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-indigo-700">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                  {project.name}
                </h3>
                <div class="flex shrink-0 items-center gap-2 text-slate-400">
                  {project.source && (
                    <a
                      href={project.source}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.name} source`}
                      class="transition hover:text-indigo-600 dark:hover:text-indigo-400"
                    >
                      <Icon name="github" class="h-5 w-5" />
                    </a>
                  )}
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.name} live`}
                      class="transition hover:text-indigo-600 dark:hover:text-indigo-400"
                    >
                      <Icon name="external" class="h-5 w-5" />
                    </a>
                  )}
                </div>
              </div>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                {project.description}
              </p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {project.tech.map((t) => (
                  <li class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {t}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
