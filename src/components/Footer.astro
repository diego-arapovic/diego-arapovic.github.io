---
import { site } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200/60 dark:border-slate-800/60">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-6 py-8 text-sm text-slate-500 sm:flex-row dark:text-slate-500"
  >
    <p>© {year} {site.name}</p>
    <p>
      Built with
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-slate-600 transition hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400"
        >Astro</a
      >
      &amp; Tailwind CSS
    </p>
  </div>
</footer>
